VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 데일리 생성/이월을 Edge Function(ensure-daily-page, 보드 권한 서버 이월)으로 처리할지.
# PLAN-daily-carryover-authority.md Phase 1. 함수 배포 + 검증 완료 후 'true' 로 켠다.
# 미설정/false 면 기존 클라이언트 권한 경로(createDailyPageV2)로 동작.
VITE_USE_EDGE_DAILY=false

# ── 멤버십 키오스크(apps/membership) 배포 전제 ─────────────────────────────
# ★기본값이 반전됐다(2026-08-17 실측 교정 — 이 줄이 옛 전제를 사실처럼 가르치고 있었다):
#   LIVE·REALTIME 은 **미설정이면 켜진다.** 아래 주석의 「'1' 이어야」는 더 이상 참이 아니다.
#   남는 위험은 반대쪽이다 — 미리보기로 두려고 **`=0` 을 적는 걸 잊으면** 데모가 실호출을 한다.
VITE_MEMBERSHIP_LIVE=1        # 기본 라이브(`api/membership.js`: `!== '0'`). 끄려면 **명시적으로 0**.
VITE_MEMBERSHIP_REALTIME=     # 빈 값이면 빌드 스크립트가 1 로 채운다(`package.json` build/build:storage).
                              #  ★선행: migrate-membership-realtime-authz.sql 적용(private 채널 RLS).
VITE_MEMBERSHIP_STORE=default # 매장 룸 id. ★키오스크와 카운터폰이 **같은 값**이어야 서로 만난다.
